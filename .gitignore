cd "/c/VSC/Проект №5/MetroLiDAR_Sentinel_Humble"

cat > .gitignore << 'GITIGNORE_EOF'
# Datasets
bags/
data/
*.db3
*.mcap
*.zst
*.bag
*.tar
*.tar.zst

# Python
.venv/
.venv_gpu/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ROS 2
build/
install/
log/
COLCON_IGNORE

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Backups
_backup_*/
*.bak

# Misc
*.so
=*

# CSV: block everything by default
*.csv

# ...but allow reference results for review
!results_v9/*.csv
!results_v9/*.log
!results/final/*.csv
!results_v11_8w/*.csv
!results_v11_8w/*.log
!results_v11/*.csv

# _archive/ — история версий, нужна экспертам
# (по умолчанию НЕ игнорируется, оставлено для прозрачности)
GITIGNORE_EOF

echo "=== .gitignore пересоздан ==="
cat .gitignore